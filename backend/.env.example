# AZAERON Backend Environment Configuration
ENVIRONMENT=development
AZAERON_DEBUG=false
LOG_LEVEL=INFO
ZERO_EXTERNAL_AI_API=true
SECRET_KEY=change-me-in-production-32-chars-long!!
REFRESH_SECRET_KEY=change-me-too-in-production-32-chars!!
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=postgresql+asyncpg://azaeron:azaeron_dev_password@localhost:5432/azaeron
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
# Browser-reachable host used only for presigned upload/download URLs.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=azaeronminio
MINIO_SECRET_KEY=azaeronminio123
MINIO_BUCKET=azaeron-documents
MINIO_SECURE=false
CORS_ORIGINS=http://localhost:3000

# Self-controlled identity email. Use SMTP_STARTTLS=false only for a local sink.
EMAIL_ENABLED=false
EMAIL_PUBLIC_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=security@azaeron.local
SMTP_STARTTLS=true
# Dedicated Fernet key required in production; keep outside source control.
IDENTITY_ENCRYPTION_KEY=
# Independent Fernet key for 24-hour encrypted idempotency receipts.
USAGE_ENCRYPTION_KEY=
INFERENCE_ENABLED=false
MODEL_REGISTRY_PATH=/etc/azaeron/models/registry.json
INFERENCE_ENDPOINT=https://inference-runtime:8000
INFERENCE_VERIFY_ENDPOINT=https://verification-runtime:8000

# Self-hosted telemetry; production requires a dedicated metrics token.
RELEASE_ID=development
OTEL_SERVICE_NAME=azaeron-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACE_SAMPLE_RATIO=1.0
METRICS_TOKEN=

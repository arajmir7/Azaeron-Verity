CREATE TABLE privacy_erasures (
	id VARCHAR(36) NOT NULL, 
	created_at TIMESTAMP WITHOUT TIME ZONE DEFAULT now() NOT NULL, 
	updated_at TIMESTAMP WITHOUT TIME ZONE DEFAULT now() NOT NULL, 
	scope VARCHAR(20) NOT NULL, 
	target_id VARCHAR(36) NOT NULL, 
	requester_id VARCHAR(36) NOT NULL, 
	organization_id VARCHAR(36), 
	receipt_digest VARCHAR(64) NOT NULL, 
	status VARCHAR(30) NOT NULL, 
	document_ids JSON NOT NULL, 
	organization_ids JSON NOT NULL, 
	object_keys JSON NOT NULL, 
	prefixes JSON NOT NULL, 
	not_before TIMESTAMP WITH TIME ZONE NOT NULL, 
	completed_at TIMESTAMP WITH TIME ZONE, 
	attempts INTEGER DEFAULT '0' NOT NULL, 
	last_error VARCHAR(40), 
	verification JSON, 
	PRIMARY KEY (id), 
	CONSTRAINT uq_erasure_target UNIQUE (scope, target_id), 
	CONSTRAINT ck_erasure_scope CHECK (scope IN ('account','organization','document')), 
	CONSTRAINT ck_erasure_status CHECK (status IN ('REQUESTED','ERASING_OBJECTS','VERIFYING','COMPLETED','FAILED'))
)

